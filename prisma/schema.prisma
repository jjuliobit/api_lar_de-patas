generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  nome      String
  sobrenome String
  telefone  String?
  idade     Int
  email     String  @unique
  sexo      Sexo
  cpf       String  @unique
  foto      String?

  account  Account?
  sessions Session[]
  pets     Pet[]
  address  Address?
  adoptions Adoption[]
  lostPets  LostPet[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Account {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pet {
  id          String    @id @default(uuid())
  userId      String
  nome        String
  idade       Int
  sexo        SexoPet
  especie     Especie
  raca        String?
  cor         String?
  foto        String?
  descricao   String?
  localizacao String?
  status      StatusPet @default(Disponivel)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adocoes Adoption[]

  @@index([userId])
  @@index([status])
  @@index([especie])
}

model Adoption {
  id          String       @id @default(uuid())
  petId       String
  userId      String
  status      StatusAdocao @default(Enviado)
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([petId, userId])
  @@index([userId])
  @@index([petId])
}

model LostPet {
  id            String          @id @default(uuid())
  userId        String
  nome          String
  especie       Especie
  sexo          SexoPetPerdido?
  raca          String?
  cor           String?
  localizacao   String
  dataUltimaVez DateTime
  descricao     String?
  foto          String?
  encontrado    Boolean         @default(false)

  nomeContato     String
  telefoneContato String
  emailContato    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([encontrado])
  @@index([especie])
}

model Address {
  id          String  @id @default(uuid())
  userId      String  @unique
  cep         String?
  logradouro  String
  numero      String
  complemento String?
  bairro      String?
  cidade      String
  estado      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Sexo {
  Feminino
  Masculino
}

enum SexoPet {
  Macho
  Femea
}

enum Especie {
  Cachorro
  Gato
  Passaro
  Outro
}

enum StatusPet {
  Disponivel
  EmProcesso
  Adotado
  Indisponivel
}

enum StatusAdocao {
  Enviado
  Analisando
  Aprovado
  Rejeitado
  Concluido
}

enum SexoPetPerdido {
  Macho
  Femea
}
